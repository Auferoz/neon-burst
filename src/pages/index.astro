---
import Layout from '../layouts/Layout.astro';
import NavCard from '../components/Astro/NavCard.astro';
import IconGamepad from '../components/Icons/IconGamepad.astro';
import IconLibrary from '../components/Icons/IconLibrary.astro';
import IconRocket from '../components/Icons/IconRocket.astro';
import IconTerminal from '../components/Icons/IconTerminal.astro';
import IconHome from '../components/Icons/IconHome.astro';
import IconFilm from '../components/Icons/IconFilm.astro';
import IconTv from '../components/Icons/IconTv.astro';
import IconMonitorPlay from '../components/Icons/IconMonitorPlay.astro';
import IconBoxes from '../components/Icons/IconBoxes.astro';
import IconBook from '../components/Icons/IconBook.astro';
import IconCheckSquare from '../components/Icons/IconCheckSquare.astro';
// Única fuente de la versión: package.json (ver "Versionado" en CLAUDE.md).
import { version } from '../../package.json';
---

<Layout title="Inicio">
	<section class="flex flex-col items-center gap-10 sm:gap-14 py-8 sm:py-2">

		<!-- Hero -->
		<div class="text-center space-y-4 px-2">
			{/* El símbolo va como imagen decorativa (alt vacío): el nombre ya está
			    escrito debajo como texto real, así que repetirlo en el alt lo
			    duplicaría para un lector de pantalla. */}
			<img
				src="/assets/nb-logo.webp"
				alt=""
				width="512"
				height="512"
				class="w-36 sm:w-44 h-auto mx-auto"
				fetchpriority="high"
			/>
			<h1 class="font-display text-3xl sm:text-4xl font-bold text-neon-blue neon-glow-blue leading-tight tracking-widest">
				NEON_BURST
			</h1>
			<p class="text-text-secondary text-sm sm:text-base leading-relaxed max-w-md mx-auto">
				Gaming tracker personal — juegos jugados, biblioteca Steam y próximos lanzamientos.
			</p>
			<p class="text-xs text-text-muted tracking-wider">
				<span aria-hidden="true">$ </span><span class="sr-only">Versión </span>v{version}
			</p>
		</div>

		<!-- Navigation cards -->
		<div class="grid grid-cols-2 sm:grid-cols-3 xl:grid-cols-4 xxl:grid-cols-5 gap-4 sm:gap-5 w-full max-w-2xl">
			<NavCard href="/playedGames" title="Played Games" subtitle="Terminados y más" accentColor="blue">
				<IconGamepad size={22} />
			</NavCard>

			<NavCard href="/mySteamGames" title="My Steam Games" subtitle="Biblioteca completa" accentColor="cyan">
				<IconLibrary size={22} />
			</NavCard>

			<NavCard href="/nextGames" title="Next Games" subtitle="Lanzamientos" accentColor="pink">
				<IconRocket size={22} />
			</NavCard>

			<NavCard href="/myLibrary" title="Game Library" subtitle="Epic, GOG, Xbox y más" accentColor="yellow">
				<IconBoxes size={22} />
			</NavCard>

			<NavCard href="/ListSeries" title="Series" subtitle="Lista de series" accentColor="indigo">
				<IconTv size={22} />
			</NavCard>

			<NavCard href="/ListMovies" title="Movies" subtitle="Lista de peliculas" accentColor="emerald">
				<IconFilm size={22} />
			</NavCard>

			<NavCard href="/ListManga" title="Manga" subtitle="Manga, manhwa y manhua" accentColor="orange">
				<IconBook size={22} />
			</NavCard>

			<NavCard href="/streaming" title="Streaming" subtitle="Cuentas y accesos" accentColor="purple">
				<IconMonitorPlay size={22} />
			</NavCard>

			<NavCard href="/myTodoist" title="Todo" subtitle="Tareas, proyectos y hábitos" accentColor="green">
				<IconCheckSquare size={22} />
			</NavCard>

			<NavCard href="https://serviceswebporfolio.adesigns7.workers.dev/" title="Services Web" subtitle="Página de servicios web" accentColor="white">
				<IconHome size={22} />
			</NavCard>

			<NavCard href="https://wdt.adesigns7.workers.dev/" title="Wuwa Database" subtitle="Wuthering Waves DataBase" accentColor="white">
				<IconHome size={22} />
			</NavCard>
		</div>
		

	</section>
</Layout>
