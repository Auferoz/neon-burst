---
import Layout from '../layouts/Layout.astro';
import StreamingPinGate from '../components/Astro/StreamingPinGate.astro';
import IconEye from '../components/Icons/IconEye.astro';
import IconEyeOff from '../components/Icons/IconEyeOff.astro';
import IconCopy from '../components/Icons/IconCopy.astro';
import IconExternalLink from '../components/Icons/IconExternalLink.astro';
import IconLock from '../components/Icons/IconLock.astro';
import { getStreamingAccounts } from '../services/streamingService';
import { PIN_LENGTH, SESSION_COOKIE, isValidSessionToken } from '../services/streamingAuth';
import { getLogoSprite } from '../data/streamingLogos';

// Hueco disponible para el logo dentro de la tarjeta. Rectangular porque estos
// logos son anchos: en un cuadrado, Apple TV+ o Disney+ quedarían diminutos.
const LOGO_BOX_W = 60;
const LOGO_BOX_H = 40;

// SSR obligatorio: la página decide qué renderizar según la cookie, así que
// no puede prerenderizarse a HTML estático.
export const prerender = false;

const unlocked = await isValidSessionToken(Astro.cookies.get(SESSION_COOKIE)?.value);

// Las cuentas sólo se consultan tras validar la sesión: si está bloqueada,
// las contraseñas ni siquiera salen de D1.
const accounts = unlocked ? await getStreamingAccounts() : [];
---

<Layout
	title="Neon Burst | Streaming"
	description="Gestión de cuentas de servicios de streaming."
	noindex
	hideMenu
>
	{!unlocked && <StreamingPinGate length={PIN_LENGTH} />}

	{unlocked && (
		<div class="space-y-6">
			<header class="space-y-3 mb-8">
				<div class="flex items-start justify-between gap-4">
					<div class="space-y-3">
						<p class="text-xs font-semibold uppercase tracking-[0.2em] text-neon-purple/80">
							Streaming &middot; {accounts.length} {accounts.length === 1 ? 'servicio' : 'servicios'}
						</p>
						<h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-text-primary">
							Streaming Services
						</h1>
					</div>
					<button
						id="lock-session"
						type="button"
						class="shrink-0 flex items-center gap-2 px-3 py-2 rounded-lg text-xs font-medium text-text-muted border border-border-default hover:text-neon-purple hover:border-neon-purple/30 hover:bg-neon-purple/10 transition-all duration-200 focus-visible:outline-2 focus-visible:outline-neon-purple"
					>
						<IconLock width={14} height={14} />
						<span class="hidden sm:inline">Bloquear</span>
					</button>
				</div>
				<div class="h-px bg-linear-to-r from-neon-purple/40 via-border-hover to-transparent"></div>
			</header>

			{accounts.length === 0 ? (
				<p class="text-sm text-text-secondary">
					No hay cuentas en <code class="text-neon-purple">streaming_accounts</code>.
					Ejecuta <code class="text-neon-purple">npm run seed-streaming</code>.
				</p>
			) : (
				<section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
					{accounts.map((service, index) => (
						<article
							class="group relative bg-surface-2/70 rounded-xl border border-border-default p-5 hover:border-neon-purple/30 hover:bg-surface-3/60 transition-all duration-300 card-fade-in"
							style={`animation-delay: ${index * 80}ms`}
							data-service={service.name}
						>
							<div class="flex items-center gap-4 mb-5">
								{/* Fondo negro a juego con el del sprite, para que el recorte no marque bordes */}
								<div class="shrink-0 w-19 h-13 rounded-lg bg-black border border-border-hover flex items-center justify-center overflow-hidden">
									{(() => {
										const sprite = getLogoSprite(service.name, LOGO_BOX_W, LOGO_BOX_H);
										return sprite ? (
											<span role="img" aria-label={`Logo de ${service.name}`} style={sprite.css}></span>
										) : (
											// Servicio que aún no está en el sprite: se cae a la URL de la BD.
											<img
												src={service.logo}
												alt={`Logo de ${service.name}`}
												width={LOGO_BOX_W}
												height={LOGO_BOX_H}
												class="max-w-15 max-h-10 object-contain"
												loading="lazy"
												decoding="async"
											/>
										);
									})()}
								</div>
								<div class="flex-1 min-w-0">
									<h2 class="text-base font-semibold text-text-primary leading-tight truncate">{service.name}</h2>
									{service.plan && (
										<span class="inline-block mt-1 text-[11px] font-medium px-2 py-0.5 rounded-full bg-neon-purple/10 text-neon-purple border border-neon-purple/20">
											{service.plan}
										</span>
									)}
								</div>
								<a
									href={service.url}
									target="_blank"
									rel="noopener noreferrer"
									class="shrink-0 text-text-muted hover:text-neon-purple transition-colors duration-200 rounded-lg focus-visible:outline-2 focus-visible:outline-neon-purple"
									aria-label={`Abrir ${service.name} en una pestaña nueva`}
									title={`Abrir ${service.name}`}
								>
									<IconExternalLink width={18} height={18} />
								</a>
							</div>

							<div class="h-px bg-border-default mb-4"></div>

							<div class="mb-3">
								<span class="text-[11px] font-medium uppercase tracking-wide text-text-muted mb-1 block">Email</span>
								<div class="flex items-center gap-2">
									<p class="flex-1 min-w-0 text-sm text-text-secondary truncate">{service.email}</p>
									<button
										type="button"
										class="copy-value shrink-0 p-1.5 rounded-lg text-text-muted hover:text-neon-purple hover:bg-neon-purple/10 transition-all duration-200 focus-visible:outline-2 focus-visible:outline-neon-purple"
										aria-label={`Copiar email de ${service.name}`}
										title="Copiar email"
										data-value={service.email}
									>
										<IconCopy width={16} height={16} />
									</button>
								</div>
							</div>

							<div>
								<span class="text-[11px] font-medium uppercase tracking-wide text-text-muted mb-1 block">Password</span>
								<div class="flex items-center gap-2">
									<div class="flex-1 min-w-0">
										<span class="password-hidden text-sm text-text-secondary tracking-wider select-none" aria-hidden="true">
											&bull;&bull;&bull;&bull;&bull;&bull;&bull;&bull;&bull;&bull;
										</span>
										<span class="password-visible hidden text-sm text-neon-purple tracking-wide select-all break-all">
											{service.password}
										</span>
									</div>
									<button
										type="button"
										class="toggle-password shrink-0 p-1.5 rounded-lg text-text-muted hover:text-neon-purple hover:bg-neon-purple/10 transition-all duration-200 focus-visible:outline-2 focus-visible:outline-neon-purple"
										aria-label={`Mostrar contraseña de ${service.name}`}
										aria-pressed="false"
										title="Mostrar/Ocultar contraseña"
										data-service={service.name}
									>
										<span class="icon-eye-off block">
											<IconEyeOff width={16} height={16} />
										</span>
										<span class="icon-eye hidden">
											<IconEye width={16} height={16} />
										</span>
									</button>
									<button
										type="button"
										class="copy-value shrink-0 p-1.5 rounded-lg text-text-muted hover:text-neon-purple hover:bg-neon-purple/10 transition-all duration-200 focus-visible:outline-2 focus-visible:outline-neon-purple"
										aria-label={`Copiar contraseña de ${service.name}`}
										title="Copiar contraseña"
										data-value={service.password}
									>
										<IconCopy width={16} height={16} />
									</button>
								</div>
							</div>

							<div class="absolute bottom-0 left-5 right-5 h-0.5 bg-linear-to-r from-neon-purple/40 to-transparent rounded-full opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
						</article>
					))}
				</section>
			)}

			<div
				id="copy-toast"
				role="status"
				aria-live="polite"
				class="fixed bottom-10 left-1/2 -translate-x-1/2 bg-neon-purple text-white text-sm font-medium px-4 py-2 rounded-lg shadow-lg opacity-0 pointer-events-none transition-opacity duration-300 z-50"
			>
				Copiado al portapapeles
			</div>
		</div>
	)}
</Layout>

<style>
	@keyframes cardFadeIn {
		from { opacity: 0; transform: translateY(12px); }
		to   { opacity: 1; transform: translateY(0); }
	}
	.card-fade-in {
		opacity: 0;
		animation: cardFadeIn 0.4s ease-out forwards;
	}

	@media (prefers-reduced-motion: reduce) {
		.card-fade-in { opacity: 1; animation: none; }
	}
</style>

<script>
	document.addEventListener('astro:page-load', () => {
		const toast = document.getElementById('copy-toast');
		const lockBtn = document.getElementById('lock-session');
		// Si no hay botón de bloquear, la página está en la pantalla de PIN.
		if (!lockBtn) return;

		const controller = new AbortController();
		const { signal } = controller;
		document.addEventListener('astro:before-swap', () => controller.abort(), { once: true });

		let toastTimeout: number | undefined;

		function showToast(): void {
			if (!toast) return;
			window.clearTimeout(toastTimeout);
			toast.classList.remove('opacity-0');
			toastTimeout = window.setTimeout(() => toast.classList.add('opacity-0'), 2000);
		}

		// El ojo ya no protege nada (el servidor decidió que puedes ver esto);
		// sólo evita que la contraseña quede a la vista de quien pase por detrás.
		document.querySelectorAll<HTMLButtonElement>('.toggle-password').forEach((btn) => {
			btn.addEventListener('click', () => {
				const card = btn.closest('article');
				const hidden = card?.querySelector<HTMLElement>('.password-hidden');
				const visible = card?.querySelector<HTMLElement>('.password-visible');
				const iconEyeOff = btn.querySelector<HTMLElement>('.icon-eye-off');
				const iconEye = btn.querySelector<HTMLElement>('.icon-eye');
				if (!hidden || !visible || !iconEyeOff || !iconEye) return;

				const show = visible.classList.contains('hidden');
				hidden.classList.toggle('hidden', show);
				visible.classList.toggle('hidden', !show);
				iconEyeOff.classList.toggle('hidden', show);
				iconEye.classList.toggle('hidden', !show);
				btn.setAttribute('aria-pressed', String(show));
				btn.setAttribute(
					'aria-label',
					`${show ? 'Ocultar' : 'Mostrar'} contraseña de ${btn.dataset.service ?? ''}`,
				);
			}, { signal });
		});

		document.querySelectorAll<HTMLButtonElement>('.copy-value').forEach((btn) => {
			btn.addEventListener('click', async () => {
				const value = btn.dataset.value;
				if (!value) return;

				try {
					await navigator.clipboard.writeText(value);
				} catch {
					// navigator.clipboard no existe fuera de contextos seguros.
					const textarea = document.createElement('textarea');
					textarea.value = value;
					textarea.style.position = 'fixed';
					textarea.style.opacity = '0';
					document.body.appendChild(textarea);
					textarea.select();
					document.execCommand('copy');
					document.body.removeChild(textarea);
				}
				showToast();
			}, { signal });
		});

		lockBtn.addEventListener('click', async () => {
			await fetch('/api/streaming/lock', { method: 'POST' });
			window.location.reload();
		}, { signal });
	});
</script>
