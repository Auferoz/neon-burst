{
  "name": "neon-burst",
  "type": "module",
  "version": "1.14.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "test": "vitest run",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "generate-types": "wrangler types",
    "sync-local": "node db/sync-local.js",
    "db:migrations": "wrangler d1 migrations list neon-burst-db --local && wrangler d1 migrations list neon-burst-db --remote",
    "db:migrate": "wrangler d1 migrations apply neon-burst-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply neon-burst-db --remote",
    "fetch-ratings": "node --env-file=.env db/fetch-ratings.js",
    "fetch-ratings:missing": "node --env-file=.env db/fetch-ratings.js --only-missing",
    "fetch-movie-scores": "node --env-file=.env db/fetch-movie-scores.js",
    "fetch-movie-scores:remote": "node --env-file=.env db/fetch-movie-scores.js --remote",
    "fetch-series-scores": "node --env-file=.env db/fetch-series-scores.js",
    "fetch-series-scores:remote": "node --env-file=.env db/fetch-series-scores.js --remote",
    "sync-steam": "node --env-file=.env db/sync-steam.js",
    "sync-steam:remote": "node --env-file=.env db/sync-steam.js --remote",
    "sync-movies": "node --env-file=.env db/sync-movies.js",
    "sync-movies:remote": "node --env-file=.env db/sync-movies.js --remote",
    "seed-series": "node --env-file=.env db/seed-series.js",
    "seed-series:remote": "node --env-file=.env db/seed-series.js --remote",
    "sync-series": "node --env-file=.env db/sync-series.js",
    "sync-series:remote": "node --env-file=.env db/sync-series.js --remote",
    "seed-streaming": "node db/seed-streaming.js",
    "seed-streaming:remote": "node db/seed-streaming.js --remote",
    "backfill-library": "node --env-file=.env db/backfill-library.js",
    "backfill-library:remote": "node --env-file=.env db/backfill-library.js --remote"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^13.1.2",
    "@astrojs/vue": "^6.0.1",
    "@tailwindcss/vite": "^4.2.1",
    "astro": "^6.0.5",
    "howlongtobeat": "^1.8.0",
    "sortablejs": "^1.15.7",
    "tailwindcss": "^4.2.1",
    "vue": "^3.5.30",
    "wrangler": "^4.76.0"
  },
  "devDependencies": {
    "@types/sortablejs": "^1.15.9",
    "vitest": "^5.0.1"
  }
}
